# Configuration WikiSI API Sync - Example Template
# Copiez ce fichier vers config/wikisi.yaml et ajustez les valeurs.
# Les valeurs peuvent être surchargées par les arguments CLI et les variables d'environnement.

wikisi:
  # Configuration pour l'API WikiSI
  api:
    # URL de base de l'API WikiSI.
    # Peut être surchargée par l'argument CLI --api-url ou la variable d'environnement WIKISI_API_URL.
    url: "${WIKISI_API_URL:-https://wikisi.e2.rie.gouv.fr/wikisi/api}"

    # Jeton d'authentification pour l'API WikiSI.
    # Ne PAS committer de tokens sensibles. Utilisez WIKISI_API_TOKEN comme variable d'environnement.
    # Peut être surchargée par l'argument CLI --api-token ou la variable d'environnement WIKISI_API_TOKEN.
    token: "${WIKISI_API_TOKEN:-}"

    # User-Agent pour les requêtes API.
    # Peut être surchargée par la variable d'environnement WIKISI_API_USER_AGENT.
    user_agent: "${WIKISI_API_USER_AGENT:-Ambulon Wiki SI Sync API/1.0}"

    # Limite d'éléments par page pour les appels API paginés (par exemple, pour les applications).
    # Peut être surchargée par l'argument CLI --page-limit ou la variable d'environnement WIKISI_API_PAGE_LIMIT.
    page_limit: "${WIKISI_API_PAGE_LIMIT:-25}"

  # Configuration de sortie pour les fichiers JSON générés
  output:
    # Répertoire de destination pour les fichiers JSON synchronisés.
    # Peut être surchargée par l'argument CLI --output-dir ou la variable d'environnement WIKISI_OUTPUT_DIR.
    directory: "${WIKISI_OUTPUT_DIR:-./wikisi-data}"

    # Nom du fichier pour les énumérations.
    # Peut être surchargée par la variable d'environnement WIKISI_ENUMERATIONS_FILE.
    enumerations_file: "${WIKISI_ENUMERATIONS_FILE:-enumerations.json}"

    # Nom du fichier pour la liste complète des applications.
    # Peut être surchargée par la variable d'environnement WIKISI_APPLICATIONS_FILE.
    applications_file: "${WIKISI_APPLICATIONS_FILE:-applications.json}"

    # Nom du fichier pour les applications formatées pour l'IA.
    # Peut être surchargée par la variable d'environnement WIKISI_APPLICATIONS_IA_FILE.
    applications_ia_file: "${WIKISI_APPLICATIONS_IA_FILE:-applicationsIA.json}"

    # Nom du fichier pour les applications formatées pour l'IA (version mini sans champs vides).
    # Peut être surchargée par la variable d'environnement WIKISI_APPLICATIONS_IA_MINI_FILE.
    applications_ia_mini_file: "${WIKISI_APPLICATIONS_IA_MINI_FILE:-applicationsIA_mini.json}"

  # Logging (commun à tous les modules)
  logging:
    # Niveau de log: "debug", "info", "warning", "error"
    # Peut être surchargée par l'argument CLI --verbose/--quiet ou la variable d'environnement WIKISI_LOG_LEVEL.
    level: "${WIKISI_LOG_LEVEL:-info}"

    # Sauvegarder les logs dans un fichier
    # Peut être surchargée par la variable d'environnement WIKISI_LOG_TO_FILE.
    log_to_file: "${WIKISI_LOG_TO_FILE:-true}"

    # Chemin du fichier de log
    # Peut être surchargée par la variable d'environnement WIKISI_LOG_FILE.
    log_file: "${WIKISI_LOG_FILE:-./wikisi-sync-api.log}"