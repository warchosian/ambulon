# Configuration pour le module PIAG (Platform Intelligence Artificielle Gouvernementale)
# Ambulon v4.7.0 - Configuration centralisée avec ConfigManager
# Copiez ce fichier vers config/piag.yaml et personnalisez-le

piag:
  # ==========================================================================
  # API RAG (Retrieval Augmented Generation)
  # URL: https://rag.api.piag.e2.rie.gouv.fr/v1
  # Utilisée par: piag-rag-collection-*, piag-rag-doc-*, piag-rag-search
  # ==========================================================================
  rag:
    api:
      # URL de base de l'API RAG PIAG
      # Variable d'env: PIAG_RAG_BASE_URL (non utilisée actuellement)
      # Argument CLI: --base-url
      base_url: "https://rag.api.piag.e2.rie.gouv.fr/v1"

      # Timeout des requêtes API RAG (en secondes)
      # Argument CLI: --timeout
      timeout: 30

    security:
      # Token API pour l'authentification Bearer (API RAG)
      # ⚠️ RECOMMANDÉ: Utilisez une variable d'environnement plutôt que de stocker le token en dur
      # Variable d'env: PIAG_RAG_API_TOKEN
      # Argument CLI: --token
      # token: "votre-token-ici"  # NON RECOMMANDÉ

      # Variable d'environnement contenant le token RAG
      # Par défaut: PIAG_RAG_API_TOKEN
      token_env_var: "PIAG_RAG_API_TOKEN"

    project:
      # ID du projet PIAG RAG
      # Variable d'env: PIAG_RAG_PROJECT_ID
      # Argument CLI: --project-id
      project_id: "votre-project-id"

      # Nom de collection par défaut (optionnel)
      # Variable d'env: PIAG_RAG_COLLECTION_NAME
      # Argument CLI: --collection-name
      # collection_name: "documents"

      # Description par défaut (optionnel)
      # Variable d'env: PIAG_RAG_COLLECTION_DESCRIPTION
      # Argument CLI: --description
      # description: "Collection de documents"

    logging:
      # Activer le logging détaillé (debug)
      # Argument CLI: --debug
      enable_debug: false

      # Logger les requêtes HTTP
      log_requests: false

      # Logger les réponses HTTP
      log_responses: false

  # ==========================================================================
  # API CHAT (Chat/Completions)
  # URL: https://preprod.api.piag.e2.rie.gouv.fr/v1/chat/completions
  # Utilisée par: piag-chat-*
  # ==========================================================================
  chat:
    api:
      # URL de l'API PIAG Chat (chat/completions)
      # Argument CLI: --api-url
      base_url: "https://preprod.api.piag.e2.rie.gouv.fr/v1/chat/completions"

      # Timeout des requêtes API Chat (en secondes)
      # Argument CLI: --timeout
      timeout: 60

    security:
      # Token API pour l'authentification Bearer (API Chat)
      # ⚠️ RECOMMANDÉ: Utilisez une variable d'environnement plutôt que de stocker le token en dur
      # Variable d'env: PIAG_CHAT_API_TOKEN
      # Argument CLI: --chat-token
      # token: "votre-token-ici"  # NON RECOMMANDÉ

      # Variable d'environnement contenant le token Chat
      # Par défaut: PIAG_CHAT_API_TOKEN
      token_env_var: "PIAG_CHAT_API_TOKEN"

    # Modèle par défaut pour l'API Chat
    # Argument CLI: --model
    model: "mte-api-piag-mistral-medium-latest"

# ==============================================================================
# HIÉRARCHIE DE PRIORITÉ (pour tous les paramètres)
# ==============================================================================
# 1. Arguments CLI (--token, --project-id, etc.) - Priorité maximale
# 2. Fichier YAML (ce fichier)
# 3. Variables d'environnement (PIAG_RAG_API_TOKEN, PIAG_CHAT_API_TOKEN, etc.)
# 4. Valeurs par défaut du code

# ==============================================================================
# VARIABLES D'ENVIRONNEMENT - RÉSUMÉ
# ==============================================================================
# RAG:
#   PIAG_RAG_API_TOKEN              Token API RAG (recommandé)
#   PIAG_RAG_PROJECT_ID             ID du projet (optionnel si dans YAML/CLI)
#   PIAG_RAG_COLLECTION_NAME        Nom collection par défaut (optionnel)
#   PIAG_RAG_COLLECTION_DESCRIPTION Description par défaut (optionnel)
#
# CHAT:
#   PIAG_CHAT_API_TOKEN             Token API Chat (recommandé)

# ==============================================================================
# EXEMPLES D'UTILISATION
# ==============================================================================
#
# --- Commandes RAG ---
#
# Lister les collections:
#   ambulon piag-rag-collection-list --config config/piag.yaml
#
# Créer une collection:
#   ambulon piag-rag-collection-add --name "Documents" --description "Collection principale"
#
# Uploader un document:
#   ambulon piag-rag-doc-upload --collection "Documents" --file document.pdf
#
# Recherche sémantique:
#   ambulon piag-rag-search --collection "Documents" --query "Quelle est la procédure ?"
#
# --- Commandes Chat ---
#
# Question basique:
#   ambulon piag-chat-basic-query --question "Bonjour, comment vas-tu ?"
#
# Question avec contexte RAG:
#   ambulon piag-chat-query --question "Résume ce document" --doc-id 123 --collection-id 456
#
# Informations API Key:
#   ambulon piag-chat-apikey-info
