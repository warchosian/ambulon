llm:
  default_provider: "kimi"
  timeout: 900
  max_retries: 3
  enable_streaming: false

  providers:
    # Alibaba Cloud (Qwen) - https://help.aliyun.com/zh/dashscope/
    alibaba:
      enabled: true
      base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
      api_key: "${ALIBABA_API_KEY:-}"  # Définir dans .env : ALIBABA_API_KEY=sk-xxx
      model: "qwen-plus"  # Options: qwen-turbo, qwen-plus, qwen-max
      temperature: 0.7
      max_tokens: 8192
      retry_delay: 2

    # Kimi (Moonshot AI)
    kimi:
      enabled: true
      base_url: "https://api.moonshot.cn/v1"
      api_key: "${KIMI_API_KEY:-}"  # Définir dans .env
      model: "moonshot-v1-128k"
      temperature: 0.7
      max_tokens: 16384
      retry_delay: 2

    # Anthropic Claude
    claude:
      enabled: true
      base_url: "https://api.anthropic.com/v1"
      api_key: "${ANTHROPIC_API_KEY:-}"  # Définir dans .env
      model: "claude-3-haiku-20240307"
      temperature: 1.0
      max_tokens: 4096

    # Google Gemini
    gemini:
      enabled: true
      base_url: "https://generativelanguage.googleapis.com/v1beta"
      api_key: "${GEMINI_API_KEY:-}"  # Définir dans .env
      model: "gemini-2.5-flash"
      temperature: 0.7
      max_tokens: 4096

  documents:
    separator: "\n\n---\n\n"
    include_metadata: true
    allowed_extensions:
      - ".md"
      - ".markdown"
      - ".txt"
    default_encoding: "utf-8"

  output:
    default_file: "response.md"
    create_output_dir: true
    save_metadata: true
    metadata_filename: "generation_metadata.json"
